[Unit]
Description=EOS Energy Optimization Server
After=network.target

[Service]
Type=simple
Environment=EOS_CONFIG_DIR=/root/EOS
Environment=EOS_DATA_DIR=/root/.local/share/net.akkudoktor.eos
ExecStart=/root/EOS/eos.sh
WorkingDirectory=/root/EOS
TimeoutStopSec=30
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
